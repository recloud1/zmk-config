#include <behaviors/mouse_keys.dtsi>
#include <behaviors/mouse_move.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 40
#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1800

#define COMBO_TERM_LONG 51

#define HYPER <&kp LEFT_GUI &kp LEFT_ALT &kp LEFT_CONTROL &kp LEFT_SHIFT>
#define MEH <&kp LEFT_ALT &kp LEFT_CONTROL &kp LEFT_SHIFT>

#define COMBO(NAME, BINDINGS, KEYPOS, LAYERS, MS) \
    combo_##NAME { \
        bindings = <BINDINGS>; \
        key-positions = KEYPOS; \
        layers = LAYERS; \
        timeout-ms = <MS>; \
    };

&lt { quick_tap_ms = <200>; };

&mt {
    quick-tap-ms = <125>;
    tapping-term-ms = <300>;
};

&mmv {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <2>;
};


/ {
    combos {
        compatible = "zmk,combos";

        COMBO(caps_word, &caps_word, <12 23>, <0>, COMBO_TERM_LONG)
        COMBO(plus_symbol, &kp KP_PLUS, <7 19>, <0>, COMBO_TERM_LONG)
        COMBO(minus_symbol, &kp KP_MINUS, <19 31>, <0>, COMBO_TERM_LONG)
        COMBO(equal_with_spaces, &equal_with_spaces, <16 19>, <0>, COMBO_TERM_LONG)
        COMBO(plus_with_spaces, &plus_with_spaces, <17 19>, <0>, COMBO_TERM_LONG)
        COMBO(return, &return, <20 38>, <0>, COMBO_TERM_LONG)
        COMBO(right_arrow_with_spaces, &right_arrow_with_spaces, <19 38>, <0>, COMBO_TERM_LONG)

        COMBO(minus_with_spaces, &minus_with_spaces, <15 19>, <0>, COMBO_TERM_LONG)

        COMBO(lpar, &kp LPAR, <7 8>, <0>, COMBO_TERM_LONG)
        COMBO(rpar, &kp RPAR, <8 9>, <0>, COMBO_TERM_LONG)

        COMBO(change_language, &kp CAPSLOCK, <38 41>, <0>, COMBO_TERM_LONG)
        COMBO(bracket, &kp LEFT_BRACKET, <31 32>, <0>, COMBO_TERM_LONG)
        COMBO(right_bracket, &kp RIGHT_BRACKET, <32 33>, <0>, COMBO_TERM_LONG)
        COMBO(equal_sign, &kp KP_EQUAL, <15 16>, <0>, COMBO_TERM_LONG)
        COMBO(copy, &copy, <26 27>, <0>, COMBO_TERM_LONG)
        COMBO(paste, &paste, <27 28>, <0>, COMBO_TERM_LONG)
        COMBO(cut, &cut, <26 28>, <0>, COMBO_TERM_LONG)
        COMBO(caret, &kp CARET, <6 18>, <0>, COMBO_TERM_LONG)

        COMBO(and_, &kp AMPERSAND, <9 21>, <0>, COMBO_TERM_LONG)
        COMBO(or_, &kp PIPE, <21 33>, <0>, COMBO_TERM_LONG)

        COMBO(mult, &kp KP_MULTIPLY, <8 20>, <0>, COMBO_TERM_LONG)
        COMBO(div, &kp KP_DIVIDE, <20 32>, <0>, COMBO_TERM_LONG)

        COMBO(dollar, &kp DOLLAR, <4 16>, <0>, COMBO_TERM_LONG)
        COMBO(percent, &kp PERCENT, <5 17>, <0>, COMBO_TERM_LONG)
        COMBO(tilde, &kp TILDE, <17 29>, <0>, COMBO_TERM_LONG)
        COMBO(hash, &kp HASH, <3 15>, <0>, COMBO_TERM_LONG)
        COMBO(backslash, &kp BACKSLASH, <15 27>, <0>, COMBO_TERM_LONG)
        COMBO(at, &kp AT_SIGN, <2 14>, <0>, COMBO_TERM_LONG)
        COMBO(gravis, &kp GRAVE, <13 25>, <0>, COMBO_TERM_LONG)
        COMBO(ground, &kp UNDERSCORE, <18 30>, <0>, COMBO_TERM_LONG)
        COMBO(excl, &kp EXCL, <1 13>, <0>, COMBO_TERM_LONG)
    };

    macros {
        right_arrow: right_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
            label = "RIGHT_ARROW";
        };

        move_on_word_left: move_on_word_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_CONTROL &kp LEFT>;
            label = "MOVE_ON_WORD_LEFT";
        };

        move_on_word_right: move_on_word_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_CONTROL &kp RIGHT>;
            label = "MOVE_ON_WORD_RIGHT";
        };

        right_arrow_with_spaces: right_arrow_with_spaces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp MINUS &kp GT &kp SPACE>;
            label = "RIGHT_ARROW_WITH_SPACES";
        };

        equal_with_spaces: equal_with_spaces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp KP_EQUAL &kp SPACE>;
            label = "EQUAL_WITH_SPACES";
        };

        increment_with_spaces: increment_with_spaces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp KP_PLUS &kp KP_EQUAL &kp SPACE>;
            label = "INCREMENT_WITH_SPACES";
        };

        plus_with_spaces: plus_with_spaces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp KP_PLUS &kp SPACE>;
            label = "PLUS_WITH_SPACES";
        };

        minus_with_spaces: minus_with_spaces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp KP_MINUS &kp SPACE>;
            label = "MINUS_WITH_SPACES";
        };

        copy: copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCMD>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp LCMD>;
            label = "COPY";
        };

        paste: paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCMD>,
                <&macro_tap>,
                <&kp V>,
                <&macro_release>,
                <&kp LCMD>;
            label = "PASTE";
        };

        cut: cut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCMD>,
                <&macro_tap>,
                <&kp X>,
                <&macro_release>,
                <&kp LCMD>;
            label = "CUT";
        };

        return: return {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp EQUAL &kp GT &kp SPACE>;
            label = "RETURN";
        };

        not_by_excl: not_by_excl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EXCL &kp EQUAL>;
            label = "NOT_BY_EXCL";
        };

        inc: inc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PLUS &kp EQUAL>;
            label = "INC";
        };

        decr: decr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp EQUAL>;
            label = "DECR";
        };

        ge: ge {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GT &kp EQUAL>;
            label = "GE";
        };

        le: le {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp EQUAL>;
            label = "LE";
        };

        walrus: walrus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp EQUAL>;
            label = "WALRUS";
        };

        or_pipes: or_pipes {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PIPE &kp PIPE>;
            label = "OR_PIPES";
        };

        rust_lambda: rust_lambda {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PIPE &kp PIPE &kp LEFT>;
            label = "RUST_LAMBDA";
        };

        and: and {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp AMPS &kp AMPS>;
            label = "AND";
        };

        hyper: hyper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                HYPER,
                <&macro_pause_for_release>,
                <&macro_release>,
                HYPER;

            label = "HYPER";
        };

        meh: meh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                MEH,
                <&macro_pause_for_release>,
                <&macro_release>,
                MEH;

            label = "MEH";
        };
    };

    behaviors {
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
  &hyper  &kp Q                &kp W                &kp E            &kp R              &kp T            &kp Y         &kp U               &kp I             &kp O             &kp P                    &hyper
  &meh    &hmr LEFT_CONTROL A  &hmr LEFT_ALT S      &hmr LEFT_GUI D  &hmr LEFT_SHIFT F  &kp G            &kp H         &hmr RIGHT_SHIFT J  &hmr RIGHT_GUI K  &hmr RIGHT_ALT L  &hmr RIGHT_CONTROL SEMI  &kp DOUBLE_QUOTES
  &meh    &kp Z                &kp X                &kp C            &kp V              &kp B            &kp N         &kp M               &kp COMMA         &kp DOT           &hmr EXCL QUESTION       &meh

                               &lt 1 ESCAPE         &lt 3 TAB        &lt 2 SPACE        &lt 5 RET        &lt 5 ESCAPE  &lt 2 RETURN        &lt 3 BACKSPACE   &lt 1 ESCAPE
            >;
        };

        mouse_layer {
            bindings = <
  &kp F1   &kp F2   &kp F3    &kp F4   &kp F5    &kp F6     &none           &none           &mmv MOVE_UP        &none                &msc SCRL_UP            &none
  &kp F7   &kp F8   &kp F9    &kp F10  &kp F11   &kp F12    &none           &mmv MOVE_LEFT  &mmv MOVE_DOWN      &mmv MOVE_RIGHT      &msc SCRL_DOWN          &none
  &kp F13  &kp F14  &kp F15   &kp F16  &kp F17   &kp F18    &none           &msc SCRL_LEFT  &none               &msc SCRL_RIGHT      &none                   &none
                    &trans  &none  &none  &none             &mkp MB3        &mkp MB1        &mkp MB2            &none
            >;
        };

        lower_layer {
            bindings = <
  &none      &none   &none      &none       &none        &none          &none                  &none   &none                  &none                 &none    &none
  &none      &none   &none      &none       &none        &none          &move_on_word_left     &none   &none                  &move_on_word_right   &none    &kp APOSTROPHE
  &trans     &kp N1  &kp N2     &kp N3      &kp N4       &kp N5         &kp N6                 &kp N7  &kp N8                 &kp N9                &kp N0   &none

                     &trans     &lt 4 TAB   &trans       &trans         &trans    &trans  &lt 4 DEL  &none
            >;
        };

        raise_layer {
            bindings = <
  &kp KP_NUM  &kp KP_SLASH     &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS    &kp K_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp PG_UP  &kp SLCK         &none
  &kp KP_N0   &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS     &kp LEFT      &kp DOWN           &kp UP           &kp RIGHT  &kp INS          &mt RCTRL K_APP
  &trans      &kp KP_N0        &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT      &kp C_VOL_DN  &kp END            &trans           &kp PG_DN  &kp PAUSE_BREAK  &trans
                               &trans     &trans     &trans     &lt 4 RET       &lt 4 ESC     &trans             &trans           &trans
            >;
        };

        adjust_layer {
            bindings = <
  &bootloader  &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &bootloader
  &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
  &sys_reset   &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &sys_reset
                             &none         &trans        &none         &trans          &trans        &none         &trans        &none
            >;
        };

        additional_combos_layer {
            bindings = <
  &trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans        &trans  &none   &none   &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans

                  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans
            >;
        };
    };
};
